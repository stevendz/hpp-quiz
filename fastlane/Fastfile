# Release-Lanes für `make release` (Ablauf: tool/release/release.sh).
# Zugangsdaten kommen aus ~/.config/hpp-release/env (siehe tool/release/README.md):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_PATH  – App Store Connect API-Schlüssel (.p8)
#   PLAY_JSON_KEY                            – Google-Play-Dienstkonto (JSON)
# Eingereicht wird nichts: App-Store-Review und Play-Freigabe bleiben manuell.

require "digest"

default_platform(:ios)

BUNDLE_ID = "dev.webrabbits.hpp"
TEAM_ID = "DJB7TXFLUC"
ROOT = File.expand_path("..", __dir__)

def root(path)
  File.join(ROOT, path)
end

def pubspec_version
  File.read(root("pubspec.yaml"))[/^version:\s*(\S+)/, 1].split("+")
end

def skip_media?
  ENV["SKIP_MEDIA"] == "1"
end

def write_out(value)
  File.write(ENV.fetch("OUT"), value.to_s)
end

PREVIEWS_UPLOADED = File.join(ROOT, "fastlane/app_previews/.uploaded")

# Prüfsummen der lokalen Preview-Videos, falls sie sich vom zuletzt hochgeladenen Stand unterscheiden – sonst nil
def pending_previews
  files = Dir[File.join(ROOT, "fastlane/app_previews/*/*.mp4")].sort
  return nil if files.empty?
  sums = files.map { |f| "#{Digest::MD5.file(f).hexdigest}  #{File.basename(f)}" }.join("\n") + "\n"
  File.exist?(PREVIEWS_UPLOADED) && File.read(PREVIEWS_UPLOADED) == sums ? nil : sums
end

platform :ios do
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH")),
      duration: 1200
    )
  end

  desc "Höchste Build-Nummer in App Store Connect (alle Versionen) nach $OUT schreiben"
  lane :latest_build do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID) || UI.user_error!("App #{BUNDLE_ID} nicht in App Store Connect gefunden")
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 200)
    write_out(builds.map { |b| b.version.to_i }.max || 0)
  end

  desc "Archiv bauen und für den App Store exportieren"
  lane :build do
    # Signiert wird über den in Xcode angemeldeten Apple-Account (Cloud-Signing, Xcode → Einstellungen → Accounts).
    # Der API-Schlüssel reicht dafür nicht (Cloud-Signing verlangt die Admin-Rolle) – er dient nur Abfragen und Uploads.
    build_app(
      workspace: root("ios/Runner.xcworkspace"),
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        teamID: TEAM_ID,
        signingStyle: "automatic",
        uploadSymbols: true,
        manageAppVersionAndBuildNumber: false, # Build-Nummer kommt aus pubspec.yaml (1.1.2 → 112)
      },
      xcargs: "-allowProvisioningUpdates", # gym übergibt xcargs auch an -exportArchive
      output_directory: root("build/ios/ipa"),
      output_name: "Runner.ipa",
      clean: true
    )
  end

  desc "Build, Texte, Screenshots und App Previews hochladen – ohne Einreichung zum Review"
  lane :upload do
    version, = pubspec_version
    options = {
      api_key: asc_api_key,
      app_identifier: BUNDLE_ID,
      platform: "ios",
      app_version: version,
      ipa: root("build/ios/ipa/Runner.ipa"),
      metadata_path: root("fastlane/metadata/ios"),
      skip_screenshots: skip_media?,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true, # keine HTML-Vorschau/Rückfrage
    }
    unless skip_media?
      # Nur geänderte Screenshots hochladen: deliver vergleicht Prüfsummen mit App Store Connect
      # (tool/release/sync_screenshots.py hält unveränderte Dateien byte-gleich).
      ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1"
      options.merge!(screenshots_path: root("fastlane/screenshots/ios"), sync_screenshots: true)
    end
    previews = pending_previews
    if previews
      # Neu gerenderte Videos (make video) ersetzen die bisherigen Previews.
      options.merge!(
        app_previews_path: root("fastlane/app_previews"),
        overwrite_preview_videos: true,
        preview_frame_time_code: "00:00:03:00"
      )
    else
      UI.message("App Previews unverändert – kein Upload (neu rendern mit: make video)")
    end
    deliver(options)
    File.write(PREVIEWS_UPLOADED, previews) if previews
  end
end

platform :android do
  def json_key
    File.expand_path(ENV.fetch("PLAY_JSON_KEY"))
  end

  desc "Höchsten versionCode aller Play-Tracks nach $OUT schreiben"
  lane :latest_code do
    codes = %w[production beta alpha internal].flat_map do |track|
      google_play_track_version_codes(package_name: BUNDLE_ID, json_key: json_key, track: track)
    rescue StandardError => e
      UI.important("Track #{track}: #{e.message}")
      []
    end
    write_out(codes.map(&:to_i).max || 0)
  end

  desc "AAB als Entwurf in Production hochladen, dazu Texte, Changelog und Screenshots – nicht zur Prüfung senden"
  lane :upload do
    upload_to_play_store(
      package_name: BUNDLE_ID,
      json_key: json_key,
      aab: root("build/app/outputs/bundle/release/app-release.aab"),
      track: "production",
      release_status: "draft",
      # Änderungen nur vorbereiten – "Zur Prüfung senden" erfolgt in der Play Console.
      # Lässt Play den Parameter für diese App nicht zu, wiederholt supply ohne ihn
      # (rescue_changes_not_sent_for_review); der Release bleibt dann trotzdem ein Entwurf.
      changes_not_sent_for_review: true,
      metadata_path: root("fastlane/metadata/android"),
      skip_upload_apk: true,
      skip_upload_images: true, # Icon und Feature-Grafik bleiben unverändert
      skip_upload_screenshots: skip_media?,
      sync_image_upload: true # nur geänderte Screenshots hochladen (Prüfsummen-Abgleich)
    )
  end
end
